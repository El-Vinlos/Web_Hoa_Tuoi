@model WebHoaTuoi.Models.SanPham
@{
    ViewBag.Title = "Chi Tiết Sản Phẩm";
}

<div class="container py-5">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light ps-0 mb-4">
            <li class="breadcrumb-item"><a class="text-decoration-none" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a class="text-decoration-none" href="@Url.Action("Index", "SanPham")">Sản phẩm</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page">@Model.TenSP</li>
        </ol>
    </nav>

    <!-- Product Detail Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="row g-0 align-items-center">

            <!-- Product Image -->
            <div class="col-lg-6 bg-light d-flex align-items-center justify-content-center p-4">
                @if (!string.IsNullOrEmpty(Model.Hinh))
                {
                    <img src="@Url.Content("~/Images/" + Model.Hinh)" class="img-fluid rounded-4" style="max-height:550px; object-fit:contain;" alt="@Model.TenSP" />
                }
                else
                {
                    <div class="text-center text-muted fs-1">🌸</div>
                }
            </div>

            <!-- Product Info -->
            <div class="col-lg-6 p-4 p-lg-5">
                <span class="badge rounded-pill text-white mb-3 px-3 py-2" style="background:linear-gradient(135deg,#ff6b9d,#c06c84)">
                    @(Model.LoaiSP?.TenLoaiSP ?? "Chưa phân loại")
                </span>

                <h1 class="display-6 fw-bold">@Model.TenSP</h1>

                <div class="d-flex align-items-center mb-3">
                    <div class="text-warning me-2">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                    </div>
                    <small class="text-muted">(124 đánh giá)</small>
                </div>

                <h3 class="text-danger fw-bold mb-4">@Model.DonGia.ToString("N0")đ</h3>

                @if (Model.SoLuong > 0)
                {
                    <p class="text-success fw-semibold mb-3">✓ Còn hàng — @Model.SoLuong sản phẩm</p>
                }
                else
                {
                    <p class="text-danger fw-semibold mb-3">✗ Hết hàng</p>
                }
                <form action="@Url.Action("AddtoCartChitiet", "SanPham")" method="post" class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    @Html.AntiForgeryToken()
                    <!-- Quantity Input -->
                    <div class="input-group" style="width:130px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="changeQty(-1)">−</button>
                        <input id="qty" name="soLuong" type="number" class="form-control text-center" value="1" min="1" max="@Model.SoLuong" />
                        <button type="button" class="btn btn-outline-secondary" onclick="changeQty(1)">+</button>
                    </div>

                    <!-- Hidden Product ID -->
                    <input type="hidden" name="maSP" value="@Model.MaSP" />

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-success px-4 shadow-sm" @(Model.SoLuong <= 0 ? "disabled" : "")>
                        <i class="bi bi-cart me-2"></i>Thêm vào giỏ
                    </button>

                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary px-4 shadow-sm">Xem giỏ hàng</a>
                </form>
                <div class="small text-muted">
                    <p><strong>Mã sản phẩm:</strong> @Model.MaSP</p>
                    <p><strong>Loại sản phẩm:</strong> @(Model.LoaiSP?.TenLoaiSP ?? "Không xác định")</p>
                </div>
            </div>
        </div>
    </div>
</div>
@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> @TempData["CartMessage"]
    </div>
}