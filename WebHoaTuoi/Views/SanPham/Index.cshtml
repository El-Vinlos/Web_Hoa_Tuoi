@model IEnumerable<WebHoaTuoi.Models.SanPham>

@{
    ViewBag.Title = "Danh Sách Sản Phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var danhMucList = ViewBag.DanhMucList as List<WebHoaTuoi.Models.LoaiSP>;
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- 🩷 SIDEBAR: Danh Mục -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="bg-white shadow-sm rounded-3 p-3">
                <h5 class="fw-bold text-primary mb-3">Danh mục</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <a href="@Url.Action("Index", "SanPham")" class="text-decoration-none d-block">
                            🌸 Tất cả sản phẩm
                        </a>
                    </li>
                    @if (danhMucList != null)
                    {
                        foreach (var loai in danhMucList)
                        {
                            var isActive = (ViewBag.TenLoai == loai.TenLoaiSP);
                            <li class="list-group-item @(isActive ? "active" : "")">
                                <a href="@Url.Action("TheoLoai", "SanPham", new { id = loai.MaLoaiSP })"
                                   class="text-decoration-none d-block @(isActive ? "text-white" : "text-dark")">
                                    @loai.TenLoaiSP
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <!-- 🌺 MAIN CONTENT: Product Grid -->
        <div class="col-lg-9 col-md-8">
            <!-- Page Title -->
            <div class="p-4 mb-4 rounded-3 text-white shadow-sm" 
                 style="background: linear-gradient(135deg, #ff6b9de6, #c06c84e6);">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                    <div>
                        <h2 class="mb-1 fw-bold">
                            @(ViewBag.TenLoai ?? "Danh Sách Sản Phẩm")
                        </h2>
                        <p class="mb-0 opacity-75 fs-6">Khám phá bộ sưu tập hoa tươi đẹp nhất</p>
                    </div>
                </div>
            </div>
            
            <!-- Product Grid -->
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 shadow-sm border-0 hover-shadow" style="transition: all 0.3s;">
                                <div class="position-relative">
                                    <img src="@Url.Content("~/Images/" + (string.IsNullOrEmpty(item.Hinh) ? "no-image.jpg" : item.Hinh))" 
                                         class="card-img-top" 
                                         alt="@item.TenSP" 
                                         style="height: 250px; object-fit: cover;">

                                    <span class="badge position-absolute top-0 end-0 m-2 px-3 py-2 rounded-pill text-white" 
                                          style="background: @(item.SoLuong > 0 ? "linear-gradient(135deg,#f093fb,#f5576c)" : "linear-gradient(135deg,#868f96,#596164)")">
                                        @(item.SoLuong > 0 ? "Còn hàng" : "Hết hàng")
                                    </span>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <div class="text-primary text-uppercase small fw-semibold mb-2">
                                        @(item.LoaiSP != null ? item.LoaiSP.TenLoaiSP : "Chưa phân loại")
                                    </div>

                                    <h5 class="card-title flex-grow-1 text-truncate" title="@item.TenSP">
                                        @item.TenSP
                                    </h5>

                                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-3">
                                        <span class="text-danger fw-bold">@item.DonGia.ToString("N0")đ</span>
                                        <small class="@(item.SoLuong > 0 ? "text-success" : "text-danger")">
                                            @(item.SoLuong > 0 ? $"✓ {item.SoLuong} sản phẩm" : "✗ Hết hàng")
                                        </small>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("ChiTietSanPham", "SanPham", new { id = item.MaSP })" 
                                           class="btn btn-primary w-100">
                                            Xem chi tiết
                                        </a>
                                    @if(item.SoLuong > 0)
                                    {
                                        <form action="@Url.Action("AddToCart", "SanPham")" method="post" class="d-inline w-100">
                                            <input type="hidden" name="maSP" value="@item.MaSP" />
                                            <input type="hidden" name="soLuong" value="1" />
                                            <button type="submit" class="btn btn-success w-100">
                                                <i class="bi bi-cart"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100" disabled>Hết hàng</button>
                                    }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center bg-white p-5 rounded-3 shadow-sm">
                    <div class="display-1 mb-3">📦</div>
                    <h4 class="text-muted">Không tìm thấy sản phẩm nào</h4>
                    <p>Vui lòng thử lại sau hoặc chọn danh mục khác</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Hover animation
    document.querySelectorAll('.hover-shadow').forEach(card => {
        card.addEventListener('mouseenter', () => card.style.transform = 'translateY(-5px)');
        card.addEventListener('mouseleave', () => card.style.transform = 'translateY(0)');
    });
</script>
