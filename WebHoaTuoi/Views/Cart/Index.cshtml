@model List<WebHoaTuoi.Models.CartItem>

@{
    ViewBag.Title = "Giỏ Hàng";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fa fa-shopping-cart"></i> Giỏ Hàng
    </h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Message"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Xóa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/Images/@item.Hinh" alt="@item.TenSP" style="width: 80px; height: 80px; object-fit: cover;" />
                            </td>
                            <td>@item.TenSP</td>
                            <td>@item.DonGia.ToString("N0") đ</td>
                            <td>
                                <div class="input-group" style="width: 130px;">
                                    <button class="btn btn-sm btn-outline-secondary btn-minus" data-masp="@item.MaSP">-</button>
                                    <input type="number" class="form-control form-control-sm text-center quantity-input" 
                                           value="@item.SoLuong" min="1" data-masp="@item.MaSP" />
                                    <button class="btn btn-sm btn-outline-secondary btn-plus" data-masp="@item.MaSP">+</button>
                                </div>
                            </td>
                            <td><strong>@item.ThanhTien.ToString("N0") đ</strong></td>
                            <td>
                                @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maSP" value="@item.MaSP" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right"><strong>Tổng cộng:</strong></td>
                        <td colspan="2"><strong class="total-amount">@ViewBag.TotalAmount.ToString("N0") đ</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="text-right mt-3">
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Tiếp tục mua hàng
            </a>
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success">
                <i class="fa fa-credit-card"></i> Thanh toán
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>Giỏ hàng trống!</h4>
            <p>Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fa fa-shopping-bag"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>
