@{
    ViewBag.Title = "Liên Hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Contact Info -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="text-danger fw-bold mb-4">
                        <i class="fa-solid fa-phone me-2"></i>Thông Tin Liên Hệ
                    </h4>

                    <div class="d-flex align-items-start mb-3 bg-light p-3 rounded">
                        <i class="fa-solid fa-location-dot fa-lg text-danger me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Địa chỉ</h6>
                            <p class="mb-0 text-muted">123 Đường Nguyễn Văn Linh<br>Quận 7, TP. Hồ Chí Minh</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3 bg-light p-3 rounded">
                        <i class="fa-solid fa-mobile-screen fa-lg text-danger me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Số điện thoại</h6>
                            <p class="mb-0 text-muted">Hotline: 1900 xxxx<br>Mobile: 0909 xxx xxx</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3 bg-light p-3 rounded">
                        <i class="fa-solid fa-envelope fa-lg text-danger me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Email</h6>
                            <p class="mb-0 text-muted">info@hoatuoixinh.vn<br>support@hoatuoixinh.vn</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start bg-light p-3 rounded">
                        <i class="fa-regular fa-clock fa-lg text-danger me-3"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Giờ làm việc</h6>
                            <p class="mb-0 text-muted">Thứ 2 - Thứ 7: 8:00 - 20:00<br>Chủ nhật: 8:00 - 18:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4 class="text-danger fw-bold mb-4">
                        <i class="fa-solid fa-paper-plane me-2"></i>Gửi Tin Nhắn Cho Chúng Tôi
                    </h4>

                    <form>
                        <div class="mb-3">
                            <label for="name" class="form-label">Họ và tên *</label>
                            <input type="text" class="form-control" id="name" placeholder="Nhập họ và tên của bạn" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email *</label>
                            <input type="email" class="form-control" id="email" placeholder="Nhập email của bạn" required>
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label">Số điện thoại</label>
                            <input type="tel" class="form-control" id="phone" placeholder="Nhập số điện thoại của bạn">
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label">Tiêu đề *</label>
                            <input type="text" class="form-control" id="subject" placeholder="Nhập tiêu đề tin nhắn" required>
                        </div>

                        <div class="mb-3">
                            <label for="message" class="form-label">Nội dung *</label>
                            <textarea class="form-control" id="message" rows="4" placeholder="Nhập nội dung tin nhắn của bạn..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger px-4 fw-semibold">
                            <i class="fa-solid fa-paper-plane me-1"></i>Gửi Tin Nhắn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Map -->
    <div class="card shadow-sm border-0 mt-5">
        <div class="card-body">
            <h4 class="text-danger fw-bold mb-4">
                <i class="fa-solid fa-map-location-dot me-2"></i>Vị Trí Cửa Hàng
            </h4>
            <div class="ratio ratio-16x9 rounded overflow-hidden">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2234.9094353210967!2d-3.1903639038553373!3d55.93360790882897!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4887c77bd7af44a7%3A0xb4344037b682a5b0!2sDick%20Place!5e0!3m2!1sen!2s!4v1762193240706!5m2!1sen!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</div>
