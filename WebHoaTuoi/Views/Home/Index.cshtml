@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO SECTION -->
<section class="text-center text-white rounded-4 shadow mb-5 overflow-hidden position-relative"
         style=" background: linear-gradient(135deg, #ff6b9de6, #c06c84e6), url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=1200') center/cover;
          padding: 40px 15px; ">
    <div class="position-relative">
        <h1 class="display-4 fw-bold mb-3">
            <i class="fa-solid fa-seedling me-2"></i>Chào Mừng Đến Với Hoa Tươi Xinh
        </h1>
        <p class="fs-5 mb-4">Nơi lưu giữ những khoảnh khắc đẹp nhất với hoa tươi</p>
        <a href="@Url.Action("Index", "SanPham")"
           class="btn btn-light btn-lg fw-semibold rounded-pill shadow-sm px-4 py-3">
            <i class="fa-solid fa-store me-2"></i>Khám Phá Ngay
        </a>
    </div>
</section>

<!-- FEATURES SECTION -->
<section class="container my-5">
    <div class="row g-4 text-center">
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="fa-solid fa-spa fa-3x text-danger mb-3"></i>
                    <h3 class="text-danger fw-bold mb-2">Hoa Tươi 100%</h3>
                    <p class="text-muted">Cam kết hoa tươi mới nhập hàng ngày, đảm bảo chất lượng tốt nhất</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="fa-solid fa-truck-fast fa-3x text-danger mb-3"></i>
                    <h3 class="text-danger fw-bold mb-2">Giao Hàng Nhanh</h3>
                    <p class="text-muted">Giao hàng trong 2 giờ khu vực nội thành, miễn phí từ 500.000đ</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="fa-solid fa-gift fa-3x text-danger mb-3"></i>
                    <h3 class="text-danger fw-bold mb-2">Thiết Kế Độc Đáo</h3>
                    <p class="text-muted">Đội ngũ florist chuyên nghiệp thiết kế theo yêu cầu riêng của bạn</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="fa-solid fa-tags fa-3x text-danger mb-3"></i>
                    <h3 class="text-danger fw-bold mb-2">Giá Tốt Nhất</h3>
                    <p class="text-muted">Cam kết giá cả hợp lý với chất lượng sản phẩm cao cấp</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="container my-5">
    <div class="bg-white rounded-4 shadow p-5">
        <h2 class="text-center text-danger fw-bold mb-5 display-6">
            <i class="fa-solid fa-chart-simple me-2"></i>Thành Tựu Của Chúng Tôi
        </h2>
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-danger">5000+</div>
                    <div class="text-muted">Khách Hàng Hài Lòng</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-danger">200+</div>
                    <div class="text-muted">Sản Phẩm Đa Dạng</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-danger">24/7</div>
                    <div class="text-muted">Hỗ Trợ Khách Hàng</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <div class="fs-1 fw-bold text-danger">100%</div>
                    <div class="text-muted">Cam Kết Chất Lượng</div>
                </div>
            </div>
        </div>
    </div>
</section>
