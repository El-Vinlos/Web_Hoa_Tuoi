<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Website Hoa Tươi</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        header, nav, footer {
            background-color: #ff6b9d;
        }
    </style>
</head>
<body class="bg-light">

<!-- Header Section -->
<header class="text-white py-3">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="~/Content/logo.png" class="img-fluid" style="height: auto; width: 250px;">
        </div>
        <div class="text-md-end mt-3 mt-md-0">
            <h5 class="mb-1 fw-semibold"><i class="bi bi-truck me-1"></i> Giao hàng miễn phí</h5>
            <p class="mb-0">Đơn hàng từ 500.000đ</p>
        </div>
    </div>
</header>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-start" id="navbarCollapse">
                <ul class="navbar-nav mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Index", "Home")">Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("GioiThieu", "Home")">Giới Thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("Index", "SanPham")">Sản Phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white fw-semibold" href="@Url.Action("LienHe", "Home")">Liên Hệ</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Video Section -->
    <section class="py-5 bg-white text-center">
        <div class="container">
            <h2 class="mb-4 fw-bold"><i class="bi bi-music-note-beamed me-2"></i>Không gian âm nhạc thư giãn</h2>
            <div class="ratio ratio-16x9">
                <iframe src="https://www.youtube.com/embed/jfKfPfyJRdk"
                        title="YouTube video"
                        allowfullscreen></iframe>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="text-white py-4 mt-5">
        <div class="container text-center">
            <h4 class="fw-bold mb-3">Thông Tin Cá Nhân</h4>
            <p class="mb-1"><strong>Họ và tên:</strong> Vương Khánh Vinh</p>
            <p class="mb-1"><strong>Mã sinh viên:</strong> 2330130035</p>
            <p class="mb-1"><strong>Lớp:</strong> 23CDTHPM01</p>
            <p class="mt-3 mb-0">© 2024 Website Hoa Tươi - Bài tập ASP.NET MVC</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
